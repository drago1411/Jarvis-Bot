{
  "version": 2,
  "builds": [
    {
      "src": "vercel-dashboard/**/*.tsx",
      "use": "@vercel/next"
    },
    {
      "src": "vercel-dashboard/**/*.jsx",
      "use": "@vercel/next"
    },
    {
      "src": "vercel-dashboard/app/api/**/*.ts",
      "use": "@vercel/next"
    },
    {
      "src": "vercel-dashboard/app/api/**/*.js",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "vercel-dashboard/$1"
    }
  ]
}